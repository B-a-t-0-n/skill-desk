{
  "name":"skill-desk",
  "productName":"Skill Desk",
  "version":"0.6.0",
  "author":"Skill Desk contributors",
  "private":true,
  "description":"Навыки и активные сессии Codex на рабочем столе Windows",
  "repository":{"type":"git","url":"https://github.com/B-a-t-0-n/skill-desk.git"},
  "homepage":"https://github.com/B-a-t-0-n/skill-desk#readme",
  "bugs":{"url":"https://github.com/B-a-t-0-n/skill-desk/issues"},
  "engines":{"node":">=24"},
  "scripts":{
    "start":"cargo tauri dev",
    "test":"cargo test --manifest-path src-tauri/Cargo.toml",
    "test:parity":"cargo build --manifest-path src-tauri/Cargo.toml --no-default-features --example skill-desk-data && node --test tests/migration-parity.mjs",
    "test:desktop":"node scripts/smoke-tauri.mjs",
    "preview":"cargo run --manifest-path src-tauri/Cargo.toml --no-default-features --example skill-desk-data -- --preview",
    "package":"cargo tauri build"
  }
