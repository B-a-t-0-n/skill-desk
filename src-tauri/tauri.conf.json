{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Skill Desk",
  "mainBinaryName": "SkillDesk",
  "version": "0.6.0",
  "identifier": "local.skill-desk",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["../assets/icon.ico", "../assets/icon.png"],
    "shortDescription": "Codex sessions and skills on your desktop",
    "category": "DeveloperTool",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": { "installMode": "currentUser", "languages": ["Russian", "English"], "displayLanguageSelector": false }
    }
  }
}
